{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranches": [
    "dev"
  ],
  "dependencyDashboard": false,
  "pinDigests": false,
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/release.yml"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "ssh-key"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    }
  ]
}
