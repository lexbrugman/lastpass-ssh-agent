{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],

  // No dependency dashboard issue.
  dependencyDashboard: false,

  // Every merge to master publishes a release, so updates arrive in one
  // batch per week rather than a trickle of releases.
  schedule: ["before 6am on monday"],
  prConcurrentLimit: 3,

  // Let a new version sit for a few days before adopting it. This is an
  // agent that handles private keys: a compromised or yanked release should
  // have time to surface before it lands in a build.
  minimumReleaseAge: "5 days",

  // Keep Cargo.lock fresh even when no manifest range changes.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on the first day of the month"],
  },

  packageRules: [
    {
      description: [
        "release.yml is generated by dist and verified byte-for-byte at",
        "release time. An action bump here would be reverted by",
        "`dist generate` and fail the release, so dist owns those versions",
        "via github-action-commits in Cargo.toml.",
      ],
      matchManagers: ["github-actions"],
      matchFileNames: [".github/workflows/release.yml"],
      enabled: false,
    },
    {
      description: "One PR for routine crate updates keeps the release count down.",
      matchManagers: ["cargo"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "cargo dependencies",
    },
    {
      description: "Same for the actions we do own.",
      matchManagers: ["github-actions"],
      groupName: "github actions",
    },
    {
      description: [
        "ssh-key is pinned to 0.6.x because ssh-agent-lib depends on ^0.6;",
        "a 0.7 PR cannot build until ssh-agent-lib moves first.",
      ],
      matchManagers: ["cargo"],
      matchPackageNames: ["ssh-key"],
      matchUpdateTypes: ["major", "minor"],
      enabled: false,
    },
  ],
}
